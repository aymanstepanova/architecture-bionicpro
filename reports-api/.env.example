# Скопируйте в .env и подставьте значения (файл .env не коммитится).

# Обязательно — ключи S3-совместимого хранилища (MinIO и т.п.)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Опционально (есть дефолты в коде для локальной разработки)
# PORT=8001
# FRONTEND_ORIGIN=http://localhost:3000
# REDIS_URL=redis://localhost:6379
# COOKIE_NAME=sid
# CLICKHOUSE_HTTP=http://localhost:8123
# S3_ENDPOINT=http://localhost:9002
# S3_BUCKET=reports
# S3_REGION=us-east-1
# CDN_BASE_URL=http://localhost:8088
# CDN_PREFIX=/reports-cache
