# Подключения для DAG reports_etl и ch_clickhouse (docker-compose: env_file).
# Шаблон: reports-etl.example.env. Для своих значений — reports-etl.local.env + второй env_file в compose (см. .gitignore).
# Только для локального запуска.

CLICKHOUSE_HTTP=http://clickhouse:8123
CRM_DSN=postgresql://crm_user:crm_password@crm_db:5432/crm_db
TELEMETRY_DSN=postgresql://telemetry_user:telemetry_password@telemetry_db:5432/telemetry_db
