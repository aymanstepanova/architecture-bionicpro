# Шаблон для airflow/reports-etl.env (переменные DAG reports_etl и ch_clickhouse).
# Скопируйте: cp reports-etl.example.env reports-etl.env
# и при необходимости поправьте значения. Файл reports-etl.env подключается в docker-compose как env_file.

CLICKHOUSE_HTTP=http://clickhouse:8123
CRM_DSN=postgresql://crm_user:crm_password@crm_db:5432/crm_db
TELEMETRY_DSN=postgresql://telemetry_user:telemetry_password@telemetry_db:5432/telemetry_db
