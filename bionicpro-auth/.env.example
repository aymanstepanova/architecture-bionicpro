# Скопируйте в .env и подставьте значения (файл .env не коммитится).

# Обязательно — секреты не должны быть в коде
KEYCLOAK_CLIENT_SECRET=
USERPROFILE_DB_URL=

# Опционально (есть разумные дефолты в коде для локальной разработки)
# PORT=8000
# FRONTEND_ORIGIN=http://localhost:3000
# AUTH_BASE_URL=http://localhost:8000
# KEYCLOAK_BASE_URL=http://localhost:8080
# KEYCLOAK_INTERNAL_BASE_URL=http://localhost:8080
# KEYCLOAK_REALM=reports-realm
# KEYCLOAK_CLIENT_ID=bionicpro-auth
# REDIS_URL=redis://localhost:6379
# COOKIE_NAME=sid
# COOKIE_SECURE=false
# Шифрование refresh-токена в Redis (32 байта в base64); в dev можно не задавать
# REFRESH_TOKEN_ENC_KEY_B64=
